# =============================================================================
# Smart Pet Feeder - Environment Configuration Template
# Copy this file to .env on your server and replace with real production secrets
# =============================================================================

# 1. Domain Configuration (Pointing to your AWS Public IP)
DOMAIN=feeder.yourdomain.com

# 2. Let's Encrypt Registration Email (for automated SSL certificates)
ACME_EMAIL=admin@yourdomain.com

# 3. Database Credentials (PostgreSQL)
# Stored securely here in .env (never commit your actual .env to Git)
DATABASE_USER=feeder
DATABASE_PASSWORD=replace_with_a_strong_secure_password_123!
DATABASE_NAME=smart_pet_feeder
DATABASE_PORT=5432

# 4. Telegram Bot Integration
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_BOT_USERNAME=ChinChemBot

# 5. MQTT Broker Settings (Optional overrides)
MQTT_BROKER_URL=mqtt://mosquitto:1883
